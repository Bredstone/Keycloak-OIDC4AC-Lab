# Public names registered in DuckDNS.
OIDC4AC_DEMO_KEYCLOAK_URL=https://oidc4ac-keycloak.duckdns.org
OIDC4AC_DEMO_CLIENT_URL=https://oidc4ac-client.duckdns.org
OIDC4AC_DEMO_MAIL_URL=https://oidc4ac-mail.duckdns.org

# Private bootstrap credentials used only by Keycloak's master realm during
# startup. Do not publish these credentials to reviewers.
OIDC4AC_DEMO_BOOTSTRAP_USERNAME=oidc4ac-bootstrap
OIDC4AC_DEMO_BOOTSTRAP_PASSWORD=Change-this-bootstrap-password

# Public, disposable credentials for the realm-scoped, read-only reviewer
# account. The realm import grants this user only the standard view-realm role.
OIDC4AC_DEMO_REVIEWER_USERNAME=oidc4ac-demo-admin
# O4AC-3500b25109a07bf339344f1c03f2e83b
OIDC4AC_DEMO_REVIEWER_PASSWORD=O4AC-3500b25109a07bf339344f1c03f2e83b

# This key signs the Flask session cookie and must remain private.
OIDC4AC_DEMO_FLASK_SECRET=CHANGE_ME

# The demo binds its local services to these loopback ports for Caddy.
OIDC4AC_DEMO_KEYCLOAK_PORT=8080
OIDC4AC_DEMO_CLIENT_PORT=5000
OIDC4AC_DEMO_SMTP_PORT=2525
OIDC4AC_DEMO_SMTP_WEB_PORT=5080
