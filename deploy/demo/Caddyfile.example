# Caddy obtains and renews the public Let's Encrypt certificates automatically.
# Keep the three DuckDNS names in sync with demo.env.

http://oidc4ac-keycloak.duckdns.org {
    bind 0.0.0.0
}

https://oidc4ac-keycloak.duckdns.org {
    bind 0.0.0.0
    reverse_proxy 127.0.0.1:8080
}

http://oidc4ac-client.duckdns.org {
    bind 0.0.0.0
}

https://oidc4ac-client.duckdns.org {
    bind 0.0.0.0
    reverse_proxy 127.0.0.1:5000
}

# smtp4dev contains only disposable demo mail. It is intentionally public so a
# reviewer can open verification messages without a second login. Never route
# real mail or personal data to this service.
http://oidc4ac-mail.duckdns.org {
    bind 0.0.0.0
}

https://oidc4ac-mail.duckdns.org {
    bind 0.0.0.0
    reverse_proxy 127.0.0.1:5080
}
