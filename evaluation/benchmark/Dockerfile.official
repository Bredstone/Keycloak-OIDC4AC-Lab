# Official Keycloak 26.7.0 distribution on the same base image as the laboratory's fork.
FROM eclipse-temurin:21-jre-jammy@sha256:3097cbbebb7d490494a98aed2301f284b38f79eba158eef098c6fc8c8af11c23

ENV KEYCLOAK_HOME=/opt/keycloak

COPY keycloak-26.7.0.tar.gz /tmp/keycloak.tar.gz
RUN mkdir -p "${KEYCLOAK_HOME}" \
    && tar -xzf /tmp/keycloak.tar.gz -C "${KEYCLOAK_HOME}" --strip-components=1 \
    && rm /tmp/keycloak.tar.gz \
    && mkdir -p "${KEYCLOAK_HOME}/data/import"

WORKDIR ${KEYCLOAK_HOME}
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
